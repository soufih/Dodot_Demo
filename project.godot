; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[addons]

resources_spreadsheet_view/array_color_tint=100.0
resources_spreadsheet_view/color_rows=true
resources_spreadsheet_view/array_min_width=128.0
resources_spreadsheet_view/resource_preview_size=32.0
resources_spreadsheet_view/clip_headers=false
resources_spreadsheet_view/dupe_arrays=true
resources_spreadsheet_view/context_menu_on_leftclick=true
resources_spreadsheet_view/fold_docks=true
resources_spreadsheet_view/resource_cell_label_mode=1
resources_spreadsheet_view/freeze_first_column=true

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Demo"
run/main_scene="uid://bpkdfkxoa4u4p"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

DataLoader="*res://Script/Config/DataAccess/DataLoader.gd"
WeaponManager="*res://Script/Config/DataAccess/WeaponManager.gd"
ResourceManager="*res://Script/Config/DataAccess/ResourceManager.gd"
StatusEffectManager="*res://Script/Gameplay/System/StatusEffectManager.gd"
EnemyManager="*uid://dbsq2aiukow28"
UIManager="*res://Script/Gameplay/System/UIManager.gd"
VolumeManager="*res://Script/UI_Script/VolumeManager.gd"
BackpackSystem="*res://Script/Gameplay/System/BackpackSystem.gd"
EquipmentSlotSystem="*res://Script/Gameplay/System/EquipmentSlotSystem.gd"
DroppedItemSystem="*res://Script/Gameplay/System/DroppedItemSystem.gd"
WarehouseSystem="*res://Script/Gameplay/System/WarehouseSystem.gd"
DamageSystem="*res://Script/Gameplay/System/DamageSystem.gd"
LevelInformation="*res://Script/Gameplay/Map/LevelInformation.gd"

[debug]

gdscript/warnings/unused_variable=0
gdscript/warnings/unused_local_constant=0
gdscript/warnings/unused_parameter=0
gdscript/warnings/unused_signal=0

[display]

window/subwindows/embed_subwindows=false
window/stretch/mode="canvas_items"
window/per_pixel_transparency/allowed=true

[editor_plugins]

enabled=PackedStringArray("res://addons/resources_spreadsheet_view/plugin.cfg")

[file_customization]

folder_colors={
"res://Rescource/": "red",
"res://Scene/": "yellow",
"res://Script/": "blue",
"res://UI/": "teal",
"res://addons/": "purple"
}

[global_group]

Hero="玩家"
Enemy="敌人"
Weapon="武器"
Camera="摄像机"

